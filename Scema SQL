-- ----------------------------
-- Enum types
-- ----------------------------
DROP TYPE IF EXISTS ledger_type;
CREATE TYPE ledger_type AS ENUM ('DEPOSIT', 'SPEND', 'WITHDRAW');

DROP TYPE IF EXISTS transaction_status;
CREATE TYPE transaction_status AS ENUM ('PENDING', 'SUCCESS', 'FAILED');

-- ----------------------------
-- Tables
-- ----------------------------

-- Users
DROP TABLE IF EXISTS users;
CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email TEXT UNIQUE NOT NULL,
    password TEXT NOT NULL,
    created_at TIMESTAMP DEFAULT now()
);

-- Wallets
DROP TABLE IF EXISTS wallets;
CREATE TABLE wallets (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL UNIQUE,
    balance BIGINT DEFAULT 0,
    currency TEXT DEFAULT 'IDR',
    created_at TIMESTAMP DEFAULT now(),
    updated_at TIMESTAMP DEFAULT now(),
    CONSTRAINT fk_wallet_user FOREIGN KEY (user_id) REFERENCES users(id)
);

-- Ledger Entries
DROP TABLE IF EXISTS ledger_entries;
CREATE TABLE ledger_entries (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    wallet_id UUID NOT NULL,
    amount BIGINT NOT NULL,
    type ledger_type NOT NULL,
    reference_id TEXT UNIQUE,
    balance_after BIGINT NOT NULL,
    created_at TIMESTAMP DEFAULT now(),
    CONSTRAINT fk_ledger_wallet FOREIGN KEY (wallet_id) REFERENCES wallets(id)
);

-- Transactions
DROP TABLE IF EXISTS transactions;
CREATE TABLE transactions (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    wallet_id UUID NOT NULL,
    amount BIGINT NOT NULL,
    type ledger_type NOT NULL,
    status transaction_status NOT NULL DEFAULT 'PENDING',
    reference_id TEXT UNIQUE NOT NULL,
    created_at TIMESTAMP DEFAULT now(),
    CONSTRAINT fk_transaction_wallet FOREIGN KEY (wallet_id) REFERENCES wallets(id)
);

-- Refresh Tokens
DROP TABLE IF EXISTS refresh_tokens;
CREATE TABLE refresh_tokens (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID,
    token_hash TEXT NOT NULL,
    jti TEXT UNIQUE NOT NULL,
    created_at TIMESTAMP DEFAULT now()
);

-- Logs
DROP TABLE IF EXISTS logs;
CREATE TABLE logs (
    id BIGSERIAL PRIMARY KEY,
    request_id UUID NOT NULL,
    transaction_id UUID,
    level VARCHAR(10) NOT NULL,
    message TEXT NOT NULL,
    metadata JSONB,
    created_at TIMESTAMP DEFAULT now()
);

-- ----------------------------
-- Indexes (for performance)
-- ----------------------------
CREATE INDEX idx_ledger_wallet ON ledger_entries(wallet_id);
CREATE INDEX idx_logs_created_at ON logs(created_at DESC);
CREATE INDEX idx_logs_request_id ON logs(request_id);
CREATE INDEX idx_logs_transaction_id ON logs(transaction_id);
